# API Keys (local development only)
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to git

# OpenRouter - Free tier: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Tavily Web Search - Free tier: https://app.tavily.com/home
TAVILY_API_KEY=tvly-your-key-here

# Finnhub - Free tier: https://finnhub.io/dashboard/api-token
FINNHUB_API_KEY=your-key-here

# Polygon.io - Free tier: https://polygon.io/
POLYGON_API_KEY=your-key-here

# Alpaca - Paper trading: https://app.alpaca.markets/account/settings
ALPACA_API_KEY=your-key-here
ALPACA_SECRET_KEY=your-key-here

# ClickUp - API: https://app.clickup.com/settings
CLICKUP_API_KEY=pk_your-key-here
CLICKUP_LIST_ID=your-list-id

# Telegram Bot (optional) - https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=your-token-here
TELEGRAM_CHAT_ID=your-chat-id
